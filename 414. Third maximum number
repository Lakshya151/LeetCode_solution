class Solution {
public:
    int thirdMax(vector<int>& nums) {
        set<int>s(nums.begin(),nums.end());
        if(s.size()<3){ //if the size of set is less than 3 ,it return the maximum element , which is last is last element , means   reverse of begin so rbegin
            return *s.rbegin(); // if u think why '*' its because it means -> auto it=s.rbegin() , which is pointe and to get pointer value we use '*'
        }
        auto it=s.rbegin();
        advance(it,2);
        return *it;
    }
};
