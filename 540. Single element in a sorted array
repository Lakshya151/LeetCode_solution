class Solution {
public:
    int singleNonDuplicate(vector<int>& nums) {
        int l=0;
        int h=nums.size()-1;
        while(l<h){
            int mid=l+(h-l)/2;
            if(mid%2==1){ // we are accessing the even index , as if there is duplicate , that will be present at even index and index next to it.
                mid--;
            }
            if(nums[mid+1] && nums[mid]==nums[mid+1]){ //this will find the duplicate
                l=mid+2;
            }else{
                h=mid;
            }
        }
        return nums[l]; //at this point l and h are pointing the same element.
    }
};
