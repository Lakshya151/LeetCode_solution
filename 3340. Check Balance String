class Solution {
public:
    bool isBalanced(string nums) {
        int s1=0;
        int s2=0;
        for(int i=0;i<nums.size();i+=2){ // sum of numbers at even index
            int x=nums[i]-'0';
            s1+=x;
        }
        for(int i=1;i<nums.size();i+=2){ //sum of numbers at odd index
            int x=nums[i]-'0';
            s2+=x;
        }
        return s1==s2;
    }
};
