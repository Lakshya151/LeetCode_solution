class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {
        unordered_map<int,int>lastIndex; // In this map we put elements in map along with their index
        for(int i=0;i<nums.size();i++){
            if(lastIndex.count(nums[i])){ //It check if the element is already present
                if(i-lastIndex[nums[i]]<=k) return true; 
            }
            lastIndex[nums[i]]=i;
        }
        return false;
    }
};
