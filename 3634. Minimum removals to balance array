class Solution {
public:
    int minRemoval(vector<int>& nums, int k) {
        sort(nums.begin(),nums.end());
        int n=nums.size();
        int j=0;
        int ans=n;
        for(int i=0;i<n;i++){
            while(j<n && nums[j]<=(long long )nums[i]*k){
                j++;
            }
            ans=min(ans,n-(j-i));
        }
        return ans;
    }
};
